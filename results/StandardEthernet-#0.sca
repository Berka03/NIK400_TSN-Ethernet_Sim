version 3
run StandardEthernet-0-20260112-12:37:58-66963
attr configname StandardEthernet
attr datetime 20260112-12:37:58
attr datetimef 20260112-123758
attr experiment StandardEthernet
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network SimpleEthernet
attr processid 66963
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
config image-path ../inet4.5/images
config description "Standard Best-Effort traffic without gating"
config network SimpleEthernet
config sim-time-limit 30s
config **.eth[*].bitrate 100Mbps
config **.hasGlobalArp true
config **.crcMode "\"declared\""
config *.configurator.assignAddresses true
config *.configurator.addStaticRoutes true
config *.configurator.config "xml(\"<config>     <interface hosts='host1' address='10.0.0.1' netmask='255.255.255.0'/>     <interface hosts='host2' address='10.0.0.2' netmask='255.255.255.0'/> </config>\")"
config *.host1.numUdpApps 1
config *.host1.udpApp[0].typename UdpBasicApp
config *.host1.udpApp[0].destAddresses "\"10.0.0.2\""
config *.host1.udpApp[0].destPort 1000
config *.host1.udpApp[0].localPort 1000
config *.host1.udpApp[0].messageLength 100B
config *.host1.udpApp[0].sendInterval 10ms
config *.host1.udpApp[0].startTime 0.2s
config *.host1.udpApp[0].stopTime 15.0s
config *.host2.numUdpApps 1
config *.host2.udpApp[0].typename UdpSink
config *.host2.udpApp[0].localAddress "\"10.0.0.2\""
config *.host2.udpApp[0].localPort 1000
config *.visualizer.interfaceTableVisualizer.displayInterfaceTables true
config *.visualizer.canvasVisualizer.infoVisualizer.displayInfos true

